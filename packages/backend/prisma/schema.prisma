generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  repoPath    String
  language    String   @default("javascript")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sprints       Sprint[]
  notifications Notification[]
}

model Sprint {
  id                String   @id @default(cuid())
  projectId         String
  number            Int
  name              String
  status            String   @default("pending")

  currentGateNumber Int      @default(0)
  currentStep       Int      @default(0)
  isProcessing      Boolean  @default(false)

  requirementText   String?
  requirementFile   String?
  masterContext     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gates   Gate[]
  tasks   Task[]

  @@unique([projectId, number])
}

model Gate {
  id          String    @id @default(cuid())
  sprintId    String
  gateNumber  Int
  status      String    @default("pending")

  title       String
  description String?
  notes       String?
  poComment   String?

  approvedAt  DateTime?
  approvedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, gateNumber])
}

model Task {
  id           String   @id @default(cuid())
  sprintId     String
  taskId       String
  agentSlot    Int
  featureRef   String?

  title        String
  description  String
  spec         String

  status       String   @default("pending")
  currentRound Int      @default(0)
  branch       String?
  worktreePath String?

  devOutputRaw     String?
  devOutputParsed  String?
  validationResult String?
  reviewOutputRaw  String?
  reviewParsed     String?

  archVerdict      String?
  escalationReason String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sprint Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  logs   AgentLog[]

  @@unique([sprintId, taskId])
}

model AgentLog {
  id           String   @id @default(cuid())
  taskId       String
  round        Int
  phase        String

  promptLength Int?
  rawOutput    String?
  parsedOutput String?
  success      Boolean  @default(false)
  errorMsg     String?
  durationMs   Int?

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  projectId String?
  sprintId  String?

  type    String
  title   String
  message String
  payload String?

  channel String  @default("both")
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])
}

model PipelineConfig {
  id String @id @default("singleton")

  maxParallelAgents Int     @default(1)
  maxRetryRounds    Int     @default(3)
  taskTimeoutMins   Int     @default(45)
  qaChunkSize       Int     @default(5)
  masterMaxTokens   Int     @default(3000)

  telegramEnabled   Boolean @default(true)

  updatedAt DateTime @updatedAt
}
